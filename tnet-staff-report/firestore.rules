rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ฟังก์ชันเช็กว่าเป็น Admin หรือ Supervisor (ตรวจสอบจาก Collection users)
    function isSupervisor() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'supervisor'];
    }

    // 1. กฎสำหรับ Collection users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isSupervisor());
      allow delete: if isSupervisor();
    }

    // 2. กฎสำหรับ Collection reports (อ้างอิงตามรูปใน Firestore Console)
    match /reports/{reportId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isSupervisor());

      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null && (
        (
          resource.data.userId == request.auth.uid && 
          resource.data.status == 'pending' &&
          request.resource.data.userId == request.auth.uid
        ) || 
        isSupervisor()
      );

      allow delete: if request.auth != null && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'pending') ||
        isSupervisor()
      );
    }

    // 3. กฎสำหรับ Master Data (positions, projects, departments)
    match /positions/{docId} {
      allow read: if request.auth != null;
      allow write: if isSupervisor();
    }
    match /master_positions/{docId} {
      allow read: if request.auth != null;
      allow write: if isSupervisor();
    }
    
    match /projects/{docId} {
      allow read: if request.auth != null;
      allow write: if isSupervisor();
    }
    match /master_projects/{docId} {
      allow read: if request.auth != null;
      allow write: if isSupervisor();
    }

    match /departments/{docId} {
      allow read: if request.auth != null;
      allow write: if isSupervisor();
    }
    match /master_departments/{docId} {
      allow read: if request.auth != null;
      allow write: if isSupervisor();
    }
  }
}