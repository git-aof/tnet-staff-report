rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin check based on user profile role
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Master data collections – only admins can modify
    match /departments/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /positions/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /employees/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Reports collection – staff can create own reports, supervisors and admins can read all
    match /reports/{reportId} {
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff'
      );
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'supervisor', 'admin']
      );
      allow update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supervisor', 'admin']
      );

      // Sub‑collection for work‑hour entries
      match /hours/{hourId} {
        // Owner of the report or a supervisor/admin can write
        allow create, update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/reports/$(reportId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supervisor', 'admin']
        );
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'supervisor', 'admin']
        );
      }
    }
  }
}
